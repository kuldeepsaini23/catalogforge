# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
!.env.example

# app data
/data/
/data-test/
/fixtures/out/
/load/results/*
# Measured results the README cites (logs and scratch runs stay local)
!/load/results/scale-run.json
!/load/results/k6-summary.json
!/load/results/eval.md
!/load/results/real-run-1.json
!/load/results/real-run-sync.json
!/load/results/real-run-batch.json
