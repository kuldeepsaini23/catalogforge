# Postgres (docker compose maps it to 5433 so it doesn't clash with a local install)
DATABASE_URL=postgres://catalogforge:catalogforge@localhost:5433/catalogforge

# AI provider: "mock" (deterministic, no key needed) or "anthropic"
AI_PROVIDER=mock
# Required only when AI_PROVIDER=anthropic. Never commit a real key.
ANTHROPIC_API_KEY=
# Or route through Vercel AI Gateway instead (takes precedence when set). Model ids stay
# Anthropic-style below; they're mapped to the gateway's "anthropic/claude-haiku-4.5" form.
AI_GATEWAY_API_KEY=

# Models (override to move to newer generations without code changes)
AI_MODEL_CHEAP=claude-haiku-4-5
AI_MODEL_STRONG=claude-sonnet-4-5

# Use the Message Batches API when an import has at least this many products to build
AI_BATCH_THRESHOLD=100
AI_USE_BATCH=true
# Products per model call
AI_PRODUCTS_PER_CALL_CHEAP=8
AI_PRODUCTS_PER_CALL_STRONG=4

# Optional: POST a signed summary here when an import completes or fails
IMPORT_WEBHOOK_URL=
IMPORT_WEBHOOK_SECRET=

# Where uploads and photos are stored
STORAGE_DIR=./data

# Mock provider knobs (tests / load tests)
MOCK_LATENCY_MS=40
# Fraction of calls that fail with a transient error / invalid JSON (0..1)
MOCK_FAULT_RATE=0
# Every Nth call returns 429 (0 = never)
MOCK_RATE_LIMIT_EVERY=0
# How long the mock "batch" takes to end
MOCK_BATCH_DELAY_MS=2000
